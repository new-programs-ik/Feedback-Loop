# ─────────────────────────────────────────────────────────────────────────────
# Feedback Loop worker — configuration template.
# Copy to `.env` and fill in. NEVER commit the real `.env` (it is gitignored).
# On Render these are Environment Variables (and one Secret File for the Google key).
# ─────────────────────────────────────────────────────────────────────────────

# --- The AI engine -------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# --- Database (the same Supabase Postgres the website uses) ----------------------
# psycopg2 form (a legacy postgresql+psycopg2:// prefix is accepted and stripped).
# e.g. postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# --- Ratings sync (hourly) --------------------------------------------------------
# Source of class ratings: the Google Sheet. The sheet needs a service-account key
# (docs/GOOGLE_SHEET_SYNC_SETUP.md) shared as Viewer; the worker only ever reads it.
RATINGS_SOURCE=sheet
RATINGS_SHEET_ID=
RATINGS_SHEET_TABS=MLSU_Live_Class_Poll,Agentic_AI_Live_Class_Poll
GOOGLE_SA_JSON_FILE=./google-sa.json     # or GOOGLE_SA_JSON=<the key's JSON content>
# Slack cards go to the course's people (course_members); until people exist every card says
# "No owner assigned". Only classes from the last N days are pinged, at most M per hourly run
# (the sheet is the whole history). M=0 holds all cards.
NOTIFY_MAX_AGE_DAYS=10
NOTIFY_MAX_PER_RUN=25
# After a green run the worker POSTs ${UI_URL}/api/revalidate with `Authorization: Bearer $WORKER_API_KEY`.
# The website holds the same value in its own env.
WORKER_API_KEY=
# Comma-separated courses this run is scoped to (legacy; course membership lives in the database now):
ASSIGNED_COURSES=

# --- Video analysis (optional) --------------------------------------------------
VIMEO_ACCESS_TOKEN=               # docs/VIMEO_VIDEO_ACCESS.md; without it transcripts still work
VIMEO_TIMEOUT_S=30
VIMEO_MAX_RETRIES=3
VIDEO_MAX_FRAMES=                 # cap on sampled frames per class (default in video.py)
VIDEO_DISABLED=                   # set to 1 to switch frame sampling off everywhere
# Legacy knob: when off, every analysis uses the same depth regardless of the score.
DEPTH_BY_SCORE=1

# --- Class materials from Google Drive / Docs links (optional) -------------------
GOOGLE_ACCESS_TOKEN=

# --- Notifications ----------------------------------------------------------------
SLACK_BOT_TOKEN=                  # xoxb-...
SLACK_PM_CHANNEL_ID=              # the team channel id (Cxxxxxxxx) the cards post to

# --- Website --------------------------------------------------------------------
UI_URL=https://feedback-loop-ten.vercel.app
