# Copy to .env.local and fill in. .env.local is gitignored (never commit it).

# --- Supabase (Project Settings → API) ---
# Safe to expose to the browser (protected by Row-Level Security):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — NEVER exposed to the browser:
SUPABASE_SERVICE_ROLE_KEY=

# --- Analysis worker (the Python service on Render, or http://localhost:8000 locally) ---
ANALYSIS_WORKER_URL=http://localhost:8000
# Shared secret with the worker: sent as a bearer token on Sync now / analyze calls, and required
# by POST /api/revalidate (the worker pings it after every green sync). Same value on both sides.
WORKER_API_KEY=

# --- Optional ---
# Shown on the error page as the address to write to (defaults to the New Programs inbox).
NEXT_PUBLIC_SUPPORT_EMAIL=

# --- Local screenshots only (web/scripts/shots.mjs) — an @interviewkickstart.com login ---
# SHOT_EMAIL=
# SHOT_PASSWORD=
